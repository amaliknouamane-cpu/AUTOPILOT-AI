    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "amaliknouamane@gmail.com",
        "subject": "AutoPilot AI - Quotation Approval Required",
        "message": "=\n<div style=\"margin:0;padding:30px;background:#f1f5f9;font-family:Arial,sans-serif;\">\n  <div style=\"max-width:600px;margin:auto;background:#ffffff;border-radius:14px;overflow:hidden;\">\n\n    <!-- HEADER -->\n    <div style=\"background:#101827;padding:30px;color:#ffffff;\">\n      <h2 style=\"margin:0;letter-spacing:2px;\">AUTOPILOT AI</h2>\n      <p style=\"color:#a5b4fc;font-size:12px;\">\n        INTELLIGENT BUSINESS AUTOMATION\n      </p>\n      <div style=\"height:2px;background:#2563eb;margin-top:20px;\"></div>\n    </div>\n\n    <!-- CONTENT -->\n    <div style=\"padding:30px;\">\n\n      <p style=\"color:#2563eb;font-size:12px;font-weight:bold;\">\n        QUOTATION NOTIFICATION\n      </p>\n\n      <h1 style=\"color:#111827;font-size:25px;\">\n        Approval required\n      </h1>\n\n      <p style=\"color:#64748b;line-height:1.7;\">\n        A new quotation has been generated successfully.\n        Please review the details below before authorizing\n        its delivery to the customer.\n      </p>\n\n      <!-- CUSTOMER AND QUOTATION -->\n      <div style=\"background:#f8fafc;padding:20px;border-radius:10px;margin:25px 0;\">\n\n        <p style=\"color:#64748b;font-size:12px;margin:0;\">\n          CUSTOMER\n        </p>\n\n        <h3 style=\"color:#111827;margin:8px 0;\">\n          {{ $json.customer }}\n        </h3>\n\n        <p style=\"color:#64748b;font-size:12px;margin-top:20px;\">\n          QUOTATION DETAILS\n        </p>\n\n        <table style=\"width:100%;border-collapse:collapse;\">\n          <tr>\n            <th align=\"left\" style=\"padding:10px 0;color:#64748b;border-bottom:1px solid #e2e8f0;\">Product</th>\n            <th align=\"center\" style=\"padding:10px 0;color:#64748b;border-bottom:1px solid #e2e8f0;\">Qty</th>\n            <th align=\"right\" style=\"padding:10px 0;color:#64748b;border-bottom:1px solid #e2e8f0;\">Subtotal</th>\n          </tr>\n\n          {{ $json.items.map(item => `<tr><td style=\"padding:12px 0;border-bottom:1px solid #e2e8f0;color:#334155;\">${item.product_name}</td><td align=\"center\" style=\"padding:12px 0;border-bottom:1px solid #e2e8f0;\">${item.quantity}</td><td align=\"right\" style=\"padding:12px 0;border-bottom:1px solid #e2e8f0;\">${item.subtotal.toLocaleString()} MAD</td></tr>`).join('') }}\n        </table>\n\n        <div style=\"border-top:2px solid #e2e8f0;margin-top:20px;padding-top:15px;\">\n          <p style=\"color:#64748b;font-size:12px;\">\n            TOTAL AMOUNT\n          </p>\n\n          <h2 style=\"color:#2563eb;margin:5px 0;\">\n            {{ $json.total }} {{ $json.currency }}\n          </h2>\n        </div>\n      </div>\n\n      <!-- ACTION NOTICE -->\n      <div style=\"background:#eff6ff;padding:16px;border-radius:8px;\">\n        <strong style=\"color:#1d4ed8;\">\n          Action required\n        </strong>\n\n        <p style=\"color:#475569;font-size:13px;line-height:1.6;\">\n          Please review this quotation and approve or reject it\n          before it is sent to the customer.\n        </p>\n      </div>\n\n      <!-- APPROVAL BUTTONS -->\n      <div style=\"text-align:center;margin:35px 0;\">\n\n        <a href=\"{{ $execution.resumeUrl }}&amp;approved=true\"\n           style=\"background:#16a34a;color:#ffffff;padding:15px 25px;text-decoration:none;border-radius:8px;font-weight:bold;display:inline-block;margin:8px;\">\n          APPROVE QUOTATION\n        </a>\n\n        <a href=\"{{ $execution.resumeUrl }}&amp;approved=false\"\n           style=\"background:#dc2626;color:#ffffff;padding:15px 25px;text-decoration:none;border-radius:8px;font-weight:bold;display:inline-block;margin:8px;\">\n          REJECT QUOTATION\n        </a>\n\n      </div>\n\n      <!-- FOOTER -->\n      <p style=\"color:#94a3b8;font-size:12px;text-align:center;margin-top:30px;\">\n        Powered by AutoPilot AI<br/>\n        Automated Commercial Operations\n      </p>\n\n    </div>\n  </div>\n</div>\n",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "disapproveLabel": "Reject"
          }
