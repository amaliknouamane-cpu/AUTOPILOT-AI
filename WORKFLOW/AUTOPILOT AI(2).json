        "subject": "=AutoPilot AI | Your Quotation - {{ $('Webhook').item.json.body.customer_name }}",
        "message": "=\n<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:auto;padding:25px;color:#1f2937;\">\n  <h2 style=\"color:#2563eb;\">AUTOPILOT AI</h2>\n  <h3>Your quotation is ready</h3>\n\n  <p>Dear {{ $('HTTP Request1').first().json.customer }},</p>\n\n  <p>Your quotation has been reviewed and approved. Here are the details:</p>\n\n  <table style=\"width:100%;border-collapse:collapse;\">\n    <tr>\n      <th align=\"left\">Product</th>\n      <th align=\"center\">Quantity</th>\n      <th align=\"right\">Subtotal</th>\n    </tr>\n    {{ $('HTTP Request1').first().json.items.map(item => `<tr><td style=\"padding:10px 0;border-bottom:1px solid #ddd;\">${item.product_name}</td><td align=\"center\">${item.quantity}</td><td align=\"right\">${item.subtotal.toLocaleString()} MAD</td></tr>`).join('') }}\n  </table>\n\n  <h2 style=\"color:#2563eb;\">Total: {{ $('HTTP Request1').first().json.total }} MAD</h2>\n\n  <p>Thank you for choosing us.</p>\n  <p><strong>AutoPilot AI</strong><br>Automated Commercial Operations</p>\n</div>\n",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {}
            ]
          }
        }
